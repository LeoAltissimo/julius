# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# supabase
/supabase/.branches
/supabase/.temp

# App icons, artwork and all. They are generated by `pnpm icons`, which the
# build runs, so nothing here needs committing -- and keeping them out means a
# personal deployment can use artwork that belongs to someone else without that
# artwork being redistributed by this repository.
#
# A clone with no artwork gets the built-in mark. A deployment that wants its
# own sets ICON_SOURCE_URL. See assets/README.md.
/assets/icon-source.*
/public/icons/
/src/app/icon.png
