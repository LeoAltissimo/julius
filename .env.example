# Supabase project the app talks to.
#
# Both of these values are public by design: they ship to the browser and are
# safe to expose. What actually protects your data is row level security, which
# every table in supabase/migrations enables. Never put a service role key in
# this file or anywhere else in the app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
